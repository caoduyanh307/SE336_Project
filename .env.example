# Template only. Merge selected keys into .env WITHOUT overwriting existing credentials.
# An environment variable overrides .env. This file is not loaded automatically.
SE363_ENABLE_THREADS_DAILY=0
THREADS_ACCESS_TOKEN=
# Current Meta sample uses .com; older official collection uses .net.
# Only these official HTTPS API hosts are accepted; redirects are rejected.
THREADS_API_BASE=https://graph.threads.com
THREADS_SEARCH_FIELDS=id,text,timestamp,permalink,media_type
THREADS_SEARCH_TYPE=RECENT
THREADS_SEARCH_MODE=KEYWORD
THREADS_MAX_PAGES_PER_KEYWORD=2
THREADS_PAGE_LIMIT=25
THREADS_REQUEST_INTERVAL_SECONDS=4
THREADS_LOOKBACK_HOURS=48
THREADS_DAILY_MAX_REQUESTS=30
THREADS_MAX_BACKFILL_DAYS=7

# Fill ONLY after checking actual app approval, token scopes, and research policy.
# Setting these variables records your assertion; it does not grant Meta rights.
THREADS_COLLECTION_PERMISSION_STATUS=unverified
THREADS_VERIFIED_SCOPES=
# Accepted after review: metadata_only or full_text; unverified blocks collection.
THREADS_STORAGE_PERMISSION_STATUS=unverified
THREADS_REDISTRIBUTION_STATUS=not_permitted
THREADS_POLICY_REVIEWED_AT=
THREADS_SOURCE_TERMS_URL=https://developers.facebook.com/terms/
# Research retention limit chosen by project owner, not a Meta entitlement.
THREADS_RETENTION_DAYS=30

# Optional legacy evidence/product sources (not required for Threads).
SE363_ENABLE_META_DAILY=0
# Optional identity for Crossref polite API usage
CONTACT_EMAIL=

# Optional: ONLY accounts you own or are expressly authorized to access.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v25.0

# A deliberately small number of records per API invocation
GDELT_MAX_RECORDS=50
CROSSREF_ROWS=20
